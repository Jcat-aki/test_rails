<div class="page-header">
  <h1 class="page-title"><%= @team.name %> - 新規メンバー</h1>
</div>

<div class="card max-w-md p-6">
  <% if @team_member.errors.any? %>
    <ul class="form-error-list">
      <% @team_member.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  <% end %>

  <%= form_for([@team, @team_member]) do |f| %>
    <div class="grid grid-cols-1 gap-y-6">
      <div>
        <%= f.label :name, '名前', class: 'field-label' %>
        <%= f.text_field :name, class: 'field-input', required: true %>
      </div>
      <div>
        <%= f.label :email, 'メールアドレス（任意）', class: 'field-label' %>
        <%= f.text_field :email, class: 'field-input' %>
      </div>
      <div class="flex items-center gap-3">
        <%= f.submit '登録', class: 'btn-primary' %>
        <%= link_to '戻る', team_path(@team), class: 'btn-secondary' %>
      </div>
    </div>
  <% end %>
</div>
