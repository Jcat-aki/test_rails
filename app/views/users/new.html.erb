<div class="mx-auto mt-10 max-w-sm">
  <h1 class="page-title text-center">新規ユーザ登録</h1>

  <div class="card mt-6 p-6">
    <% if @user.errors.any? %>
      <ul class="form-error-list">
        <% @user.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    <% end %>

    <%= form_with(model: @user) do |f| %>
      <div class="grid grid-cols-1 gap-y-6">
        <div>
          <%= f.label :user_name, 'ユーザ名', class: 'field-label' %>
          <%= f.text_field :user_name, class: 'field-input' %>
        </div>
        <%= render 'layouts/users/input_mail', { f: } %>
        <%= render 'layouts/users/input_password', { f: } %>
        <div>
          <%= f.label :password_confirmation, 'パスワードの確認', class: 'field-label' %>
          <%= f.password_field :password_confirmation, class: 'field-input' %>
        </div>
        <%= f.submit 'ユーザ登録', class: 'btn-primary w-full' %>
      </div>
    <% end %>
  </div>

  <p class="mt-6 text-center text-sm text-gray-500">
    アカウントをお持ちの方は
    <%= link_to 'ログイン', login_path, class: 'font-semibold text-indigo-600 hover:text-indigo-500' %>
  </p>
</div>
