<div class="mx-auto mt-10 max-w-sm">
  <div class="text-center">
    <p class="text-sm font-semibold text-indigo-600"><%= @attendance.event.team.name %></p>
    <h1 class="text-2xl font-bold tracking-tight text-gray-900"><%= @attendance.event.title %></h1>
    <p class="mt-2 text-gray-600"><%= l(@attendance.event.starts_at, format: :long) %></p>
    <% if @attendance.event.location.present? %>
      <p class="text-gray-600">📍 <%= @attendance.event.location %></p>
    <% end %>
    <p class="mt-4 font-semibold text-gray-900"><%= @attendance.team_member.name %> さんの回答</p>
  </div>

  <div class="card mt-6 p-6">
    <% if @attendance.errors.any? %>
      <ul class="form-error-list">
        <% @attendance.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    <% end %>

    <%= form_with model: @attendance, url: attendance_response_path(@attendance.public_token), method: :patch do |f| %>
      <div class="grid grid-cols-1 gap-y-6">
        <div class="flex justify-center gap-4">
          <label class="flex items-center gap-1.5 text-sm text-gray-700"><%= f.radio_button :status, 'attending' %> 参加</label>
          <label class="flex items-center gap-1.5 text-sm text-gray-700"><%= f.radio_button :status, 'absent' %> 不参加</label>
          <label class="flex items-center gap-1.5 text-sm text-gray-700"><%= f.radio_button :status, 'undecided' %> 未定</label>
        </div>
        <div>
          <%= f.label :comment, 'コメント（任意）', class: 'field-label' %>
          <%= f.text_area :comment, class: 'field-input' %>
        </div>
        <%= f.submit '回答する', class: 'btn-primary w-full' %>
      </div>
    <% end %>
  </div>
</div>
