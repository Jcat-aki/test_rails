<div class="page-header">
  <div>
    <p class="text-sm text-gray-500">
      <%= link_to @team.name, team_path(@team), class: 'hover:text-gray-700' %> /
    </p>
    <h1 class="page-title">イベント一覧</h1>
  </div>
  <%= link_to 'イベント作成', new_team_event_path(@team), class: 'btn-primary' %>
</div>

<div class="card">
  <table class="table">
    <thead class="table-header">
      <tr>
        <th scope="col" class="table-5-cell">イベント</th>
        <th scope="col" class="table-5-cell">日時</th>
        <th scope="col" class="table-5-cell text-right">操作</th>
      </tr>
    </thead>
    <tbody class="divide-y divide-gray-100">
      <% @events.each do |event| %>
        <tr class="row">
          <th scope="row" class="table-5-cell table-cell"><%= event.title %></th>
          <td class="table-5-cell"><%= l(event.starts_at, format: :long) %></td>
          <td class="table-5-cell text-right">
            <%= link_to '詳細', team_event_path(@team, event), class: 'btn-secondary btn-sm' %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
  <% if @events.empty? %>
    <p class="px-6 py-8 text-center text-sm text-gray-500">イベントはまだありません。</p>
  <% end %>
</div>
