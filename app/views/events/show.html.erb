<div class="page-header">
  <div>
    <p class="text-sm text-gray-500">
      <%= link_to @team.name, team_path(@team), class: 'hover:text-gray-700' %> /
      <%= link_to 'イベント一覧', team_events_path(@team), class: 'hover:text-gray-700' %> /
    </p>
    <h1 class="page-title"><%= @event.title %></h1>
    <p class="mt-1 text-sm text-gray-600"><%= l(@event.starts_at, format: :long) %></p>
    <% if @event.location.present? %>
      <p class="text-sm text-gray-600">📍 <%= @event.location %></p>
    <% end %>
    <% if @event.participation_fee.present? %>
      <p class="text-sm text-gray-600">参加費 <%= number_to_currency(@event.participation_fee, unit: '¥', precision: 0) %></p>
    <% end %>
  </div>
  <%= link_to 'イベント編集', edit_team_event_path(@team, @event), class: 'btn-secondary' %>
</div>

<h2 class="section-title mb-3">出欠サマリー</h2>
<div class="mb-8 grid grid-cols-2 gap-4 sm:grid-cols-4">
  <div class="card p-4 text-center">
    <p class="text-2xl font-bold text-green-700"><%= @summary[:attending] %></p>
    <p class="text-sm text-gray-500">参加</p>
  </div>
  <div class="card p-4 text-center">
    <p class="text-2xl font-bold text-red-700"><%= @summary[:absent] %></p>
    <p class="text-sm text-gray-500">不参加</p>
  </div>
  <div class="card p-4 text-center">
    <p class="text-2xl font-bold text-yellow-700"><%= @summary[:undecided] %></p>
    <p class="text-sm text-gray-500">未定</p>
  </div>
  <div class="card p-4 text-center">
    <p class="text-2xl font-bold text-gray-700"><%= @summary[:unanswered] %></p>
    <p class="text-sm text-gray-500">未回答</p>
  </div>
</div>

<% if @unanswered_attendances.any? %>
  <h2 class="section-title mb-3">未回答者へのリマインド</h2>
  <div class="card mb-8 p-4">
    <p class="mb-2 text-sm text-gray-600">このテキストをコピーしてLINEに貼り付けてください（メンバーごとに専用URLです）。</p>
    <textarea readonly rows="<%= @unanswered_attendances.size + 1 %>" class="field-input"><%= event_reminder_text(@event, @unanswered_attendances) %></textarea>
  </div>
<% end %>

<h2 class="section-title mb-3">出欠一覧</h2>
<div class="card mb-8">
  <table class="table">
    <thead class="table-header">
      <tr>
        <th scope="col" class="table-5-cell">メンバー</th>
        <th scope="col" class="table-5-cell">状態</th>
        <th scope="col" class="table-5-cell">コメント</th>
      </tr>
    </thead>
    <tbody class="divide-y divide-gray-100">
      <% @event.attendances.includes(:team_member).order('team_members.name').each do |attendance| %>
        <tr class="row">
          <th scope="row" class="table-5-cell table-cell"><%= attendance.team_member.name %></th>
          <td class="table-5-cell">
            <%= { 'attending' => '参加', 'absent' => '不参加', 'undecided' => '未定', 'unanswered' => '未回答' }[attendance.status] %>
          </td>
          <td class="table-5-cell"><%= attendance.comment %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>

<% if @event.participation_fee.present? %>
  <h2 class="section-title mb-3">参加費支払い状況</h2>
  <div class="mb-4 grid max-w-sm grid-cols-2 gap-4">
    <div class="card p-4 text-center">
      <p class="text-2xl font-bold text-green-700"><%= @payment_summary[:paid] %></p>
      <p class="text-sm text-gray-500">支払済み</p>
    </div>
    <div class="card p-4 text-center">
      <p class="text-2xl font-bold text-yellow-700"><%= @payment_summary[:unpaid] %></p>
      <p class="text-sm text-gray-500">未払い</p>
    </div>
  </div>
  <div class="card mb-2">
    <table class="table">
      <thead class="table-header">
        <tr>
          <th scope="col" class="table-5-cell">メンバー</th>
          <th scope="col" class="table-5-cell">金額</th>
          <th scope="col" class="table-5-cell">状態</th>
          <th scope="col" class="table-5-cell text-right">操作</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-100">
        <% @event.payments.includes(:team_member).order('team_members.name').each do |payment| %>
          <tr class="row">
            <th scope="row" class="table-5-cell table-cell"><%= payment.team_member.name %></th>
            <td class="table-5-cell"><%= number_to_currency(payment.amount, unit: '¥', precision: 0) %></td>
            <td class="table-5-cell"><%= payment.paid? ? '支払済み' : '未払い' %></td>
            <td class="table-5-cell text-right">
              <%= button_to(payment.paid? ? '未払いに戻す' : '支払済みにする',
                            team_event_payment_path(@team, @event, payment),
                            method: :patch,
                            params: { payment: { status: payment.paid? ? 'unpaid' : 'paid' } },
                            class: 'btn-secondary btn-sm') %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
  <p class="mb-8 text-sm text-gray-500">参加（attending）に回答したメンバーのみ一覧に表示されます。</p>
<% end %>

<div class="mb-4 flex items-center justify-between">
  <h2 class="section-title">担当タスク</h2>
  <%= link_to 'タスクを追加', new_task_path(task: { event_id: @event.id, team_id: @team.id }), class: 'btn-primary btn-sm' %>
</div>
<div class="card">
  <table class="table">
    <thead class="table-header">
      <tr>
        <th scope="col" class="table-5-cell">タスク</th>
        <th scope="col" class="table-5-cell">担当者</th>
        <th scope="col" class="table-5-cell">状態</th>
      </tr>
    </thead>
    <tbody class="divide-y divide-gray-100">
      <% @event.tasks.includes(:assignee_team_member).each do |task| %>
        <tr class="row">
          <th scope="row" class="table-5-cell table-cell"><%= task.title %></th>
          <td class="table-5-cell"><%= task.assignee_team_member&.name || '未割当' %></td>
          <td class="table-5-cell"><%= task.finished_at.present? ? '完了' : '未完了' %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
