<div class="card max-w-xl p-6">
  <% if event.errors.any? %>
    <ul class="form-error-list">
      <% event.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  <% end %>

  <%= form_for([team, event]) do |f| %>
    <div class="grid grid-cols-1 gap-y-6">
      <div>
        <%= f.label :title, 'イベント名', class: 'field-label' %>
        <%= f.text_field :title, class: 'field-input', required: true %>
      </div>
      <div>
        <%= f.label :starts_at, '開始日時', class: 'field-label' %>
        <%= f.datetime_field :starts_at, class: 'field-input', required: true %>
      </div>
      <div>
        <%= f.label :ends_at, '終了日時（任意）', class: 'field-label' %>
        <%= f.datetime_field :ends_at, class: 'field-input' %>
      </div>
      <div>
        <%= f.label :location, '場所（任意）', class: 'field-label' %>
        <%= f.text_field :location, class: 'field-input' %>
      </div>
      <div>
        <%= f.label :participation_fee, '参加費（円・任意）', class: 'field-label' %>
        <%= f.number_field :participation_fee, class: 'field-input', min: 0 %>
      </div>
      <div>
        <%= f.label :note, 'メモ（任意）', class: 'field-label' %>
        <%= f.text_area :note, class: 'field-input' %>
      </div>
      <div class="flex items-center gap-3">
        <%= f.submit submit_label, class: 'btn-primary' %>
        <%= link_to '戻る', team_events_path(team), class: 'btn-secondary' %>
      </div>
    </div>
  <% end %>
</div>
