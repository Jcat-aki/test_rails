<div class="mx-auto mt-10 max-w-sm">
  <h1 class="page-title text-center">ログイン</h1>

  <div class="card mt-6 p-6">
    <%= form_for(:session, url: login_path) do |f| %>
      <div class="grid grid-cols-1 gap-y-6">
        <%= render 'layouts/users/input_mail', { f: } %>
        <%= render 'layouts/users/input_password', { f: } %>
        <%= f.submit 'ログイン', class: 'btn-primary w-full' %>
      </div>
    <% end %>
  </div>

  <p class="mt-6 text-center text-sm text-gray-500">
    アカウントをお持ちでない方は
    <%= link_to '新規登録', signup_path, class: 'font-semibold text-indigo-600 hover:text-indigo-500' %>
  </p>
</div>
