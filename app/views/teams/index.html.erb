<div class="page-header">
  <h1 class="page-title">チーム一覧</h1>
  <%= link_to 'チームを作成', new_team_path, class: 'btn-primary' %>
</div>

<div class="card">
  <table class="table">
    <thead class="table-header">
      <tr>
        <th scope="col" class="table-5-cell">チーム名</th>
        <th scope="col" class="table-5-cell text-right">操作</th>
      </tr>
    </thead>
    <tbody class="divide-y divide-gray-100">
      <% @teams.each do |team| %>
        <tr class="row">
          <th scope="row" class="table-5-cell table-cell"><%= team.name %></th>
          <td class="table-5-cell text-right">
            <%= link_to '詳細', team_path(team), class: 'btn-secondary btn-sm' %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
  <% if @teams.empty? %>
    <p class="px-6 py-8 text-center text-sm text-gray-500">チームはまだありません。</p>
  <% end %>
</div>
