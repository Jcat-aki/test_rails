<div class="mx-auto max-w-2xl text-center">
  <h1 class="text-3xl font-bold tracking-tight text-gray-900 sm:text-4xl">チーム一覧</h1>
</div>
<div class="mt-4 mb-4">
  <table class="table">
    <thead class="table-header">
      <tr>
        <th scope="col" class="table-5-cell">チーム名</th>
        <th scope="col" class="table-5-cell"></th>
      </tr>
    </thead>
    <tbody>
      <% @teams.each do |team| %>
        <tr class="row">
          <th scope="row" class="table-5-cell table-cell"><%= team.name %></th>
          <td class="table-5-cell">
            <%= button_to '詳細', team_path(team), method: :get %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
<%= button_to 'チームを作成', new_team_path, method: :get, class: 'text-white bg-blue-700 hover:bg-blue-800 focus:ring-4 focus:ring-blue-300 font-medium rounded-lg text-sm px-5 py-2.5 me-2 mb-2 dark:bg-blue-600 dark:hover:bg-blue-700 focus:outline-none dark:focus:ring-blue-800' %>
