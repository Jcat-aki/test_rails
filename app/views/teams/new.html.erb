<div class="page-header">
  <h1 class="page-title">新規チーム</h1>
</div>

<div class="card max-w-md p-6">
  <% if @team.errors.any? %>
    <ul class="form-error-list">
      <% @team.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  <% end %>

  <%= form_for(@team) do |f| %>
    <div class="grid grid-cols-1 gap-y-6">
      <div>
        <%= f.label :name, 'チーム名', class: 'field-label' %>
        <%= f.text_field :name, class: 'field-input', required: true %>
      </div>
      <div class="flex items-center gap-3">
        <%= f.submit 'チーム作成', class: 'btn-primary' %>
        <%= link_to '戻る', teams_path, class: 'btn-secondary' %>
      </div>
    </div>
  <% end %>
</div>
