<div class="page-header">
  <div>
    <p class="text-sm text-gray-500">
      <%= link_to 'チーム一覧', teams_path, class: 'hover:text-gray-700' %> /
    </p>
    <h1 class="page-title"><%= @team.name %></h1>
  </div>
  <div class="flex gap-2">
    <%= link_to 'イベント一覧', team_events_path(@team), class: 'btn-secondary' %>
    <%= link_to 'チーム編集', edit_team_path(@team), class: 'btn-secondary' %>
  </div>
</div>

<div class="mb-4 flex items-center justify-between">
  <h2 class="section-title">メンバー一覧</h2>
  <%= link_to 'メンバー追加', new_team_team_member_path(@team), class: 'btn-primary btn-sm' %>
</div>
<div class="card">
  <table class="table">
    <thead class="table-header">
      <tr>
        <th scope="col" class="table-5-cell">名前</th>
        <th scope="col" class="table-5-cell">メールアドレス</th>
        <th scope="col" class="table-5-cell">状態</th>
        <th scope="col" class="table-5-cell text-right">操作</th>
      </tr>
    </thead>
    <tbody class="divide-y divide-gray-100">
      <% @team_members.each do |member| %>
        <tr class="row">
          <th scope="row" class="table-5-cell table-cell"><%= member.name %></th>
          <td class="table-5-cell"><%= member.email %></td>
          <td class="table-5-cell"><%= member.active? ? '有効' : '無効' %></td>
          <td class="table-5-cell">
            <div class="flex justify-end gap-2">
              <%= button_to '編集', edit_team_team_member_path(@team, member), method: :get, class: 'btn-secondary btn-sm' %>
              <%= button_to '無効化', deactivate_team_team_member_path(@team, member), method: :patch, disabled: member.inactive?, class: 'btn-danger btn-sm' %>
            </div>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
  <% if @team_members.empty? %>
    <p class="px-6 py-8 text-center text-sm text-gray-500">メンバーはまだいません。</p>
  <% end %>
</div>
