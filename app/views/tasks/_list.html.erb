<div class="card">
  <table class="table">
    <thead class="table-header">
      <tr>
        <th scope="col" class="table-5-cell">タスク名</th>
        <th scope="col" class="table-5-cell">期日</th>
        <th scope="col" class="table-5-cell text-right">操作</th>
      </tr>
    </thead>
    <tbody class="divide-y divide-gray-100">
      <% @tasks.each do |task| %>
        <tr class="row">
          <th scope="row" class="table-5-cell table-cell">
            <%= task.title %>
          </th>
          <td class="table-5-cell">
            <%= task.limit_date ? l(task.limit_date, format: :date) : '-' %>
          </td>
          <td class="table-5-cell">
            <div class="flex justify-end gap-2">
              <%= button_to '達成！', finished_task_path(task), method: :patch, disabled: task.finished_at.present?, class: 'btn-primary btn-sm' %>
              <%= button_to '編集', edit_task_path(task), method: :get, class: 'btn-secondary btn-sm' %>
              <%= button_to '削除', task_path(task), method: :delete, class: 'btn-danger btn-sm', data: { turbo_confirm: '削除しますか？' } %>
            </div>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
  <% if @tasks.empty? %>
    <p class="px-6 py-8 text-center text-sm text-gray-500">タスクはまだありません。</p>
  <% end %>
</div>
