<div class="page-header">
  <h1 class="page-title">タスク編集</h1>
</div>

<div class="card max-w-xl p-6">
  <% if @task.errors.any? %>
    <ul class="form-error-list">
      <% @task.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  <% end %>

  <%= form_for(@task) do |f| %>
    <div class="grid grid-cols-1 gap-y-6">
      <%= render 'layouts/tasks/input_title', { f: } %>
      <%= render 'layouts/tasks/input_limit_date', { f: } %>
      <%= render 'layouts/tasks/input_team', { f: } %>
      <%= render 'layouts/tasks/input_event', { f: } %>
      <%= render 'layouts/tasks/input_assignee', { f: } %>
      <div class="mt-4 flex items-center gap-3">
        <%= f.submit 'タスク更新', class: 'btn-primary' %>
        <%= link_to '戻る', tasks_path, class: 'btn-secondary' %>
      </div>
    </div>
  <% end %>
</div>
